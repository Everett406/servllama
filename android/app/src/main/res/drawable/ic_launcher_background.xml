<?xml version="1.0" encoding="utf-8"?>
<!-- Flat clay behind the adaptive foreground. A colour resource rather than
     a bitmap: the launcher scales it, and a raster here would just be a
     bigger file that gets resampled. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#C85E40" />
</shape>
